{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Notion Lite",
  "windows": ["*"],
  "webviews": ["*"],
  "remote": {
    "urls": [
      "https://*.notion.so/*",
      "https://*.notion.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "shell:default",
    "dialog:default",
    "updater:default"
  ]
}
