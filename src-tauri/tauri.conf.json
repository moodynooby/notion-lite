{
    "productName": "Notion Lite",
    "version": "0.3.0",
    "identifier": "io.notion-lite.desktop",
    "build": {
        "frontendDist": "assets"
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/moodynooby/Notion/releases/latest/download/latest.json"
            ],
            "dialog": true,
            "pubkey": "RWQpCdih9OnWkf2sTicrpau6XAB8D8xKOqoMNnTcbAZfJ14SN5bCFkl/"
        }
    },
    "app": {
        "security": {
            "csp": "default-src 'self' notion.so *.notion.so notion-static.com tauri://localhost wry://localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' notion.so *.notion.so notion-static.com tauri://localhost wry://localhost; connect-src 'self' notion.so *.notion.so notion-static.com tauri://localhost wry://localhost; img-src 'self' data: blob: notion.so *.notion.so notion-static.com; style-src 'self' 'unsafe-inline' notion.so *.notion.so; font-src 'self' data: notion.so *.notion.so;"
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "rpm",
            "appimage",
            "dmg",
            "nsis"
        ],
        "icon": [
            "assets/icons/16x16.png",
            "assets/icons/32x32.png",
            "assets/icons/48x48.png",
            "assets/icons/64x64.png",
            "assets/icons/128x128.png",
            "assets/icons/128x128@2x.png",
            "assets/icons/256x256.png",
            "assets/icons/512x512.png",
            "assets/icon.png",
            "assets/icon.ico",
            "assets/icon.icns"
        ],
        "category": "Productivity",
        "shortDescription": "Native lightweight client for Notion.so",
        "longDescription": "Notion Lite is a fast, memory-efficient native Rust desktop client for Notion.so, built with Tauri v2. Features Zero-Trust security, LiteBox sandboxing, and custom theming.",
        "resources": [
            "assets/*",
            "i18n/**/*"
        ],
        "linux": {
            "deb": {
                "depends": [
                    "libc6 (>= 2.34)",
                    "libwebkit2gtk-4.1-0",
                    "libgtk-3-0",
                    "libayatana-appindicator3-1",
                    "librsvg2-common",
                    "ca-certificates"
                ],
                "files": {
                    "/usr/share/applications/notion-lite.desktop": "assets/notion-lite.desktop",
                    "/usr/share/pixmaps/notion-lite.png": "assets/icons/256x256.png",
                    "/usr/share/icons/hicolor/16x16/apps/notion-lite.png": "assets/icons/16x16.png",
                    "/usr/share/icons/hicolor/32x32/apps/notion-lite.png": "assets/icons/32x32.png",
                    "/usr/share/icons/hicolor/48x48/apps/notion-lite.png": "assets/icons/48x48.png",
                    "/usr/share/icons/hicolor/64x64/apps/notion-lite.png": "assets/icons/64x64.png",
                    "/usr/share/icons/hicolor/128x128/apps/notion-lite.png": "assets/icons/128x128.png",
                    "/usr/share/icons/hicolor/256x256/apps/notion-lite.png": "assets/icons/256x256.png",
                    "/usr/share/icons/hicolor/512x512/apps/notion-lite.png": "assets/icons/512x512.png"
                },
                "postInstallScript": "scripts/postinst.sh",
                "postRemoveScript": "scripts/postrm.sh"
            }
        }
    }
}