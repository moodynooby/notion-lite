pkgname=notion-lite
pkgver=0.3.32
pkgrel=1
pkgdesc='Native lightweight client for Notion.so'
arch=('x86_64' 'aarch64')
url='https://github.com/moodynooby/notion-lite'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'openssl' 'gcc-libs' 'hunspell')
makedepends=('git' 'rust' 'clang')
source=("notion-lite::git+https://github.com/moodynooby/notion-lite.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/notion-lite"
    cargo build --release --manifest-path src-tauri/Cargo.toml
}

package() {
    cd "${srcdir}/notion-lite"

    install -Dm755 src-tauri/target/release/notion-lite \
        "${pkgdir}/usr/bin/notion-lite"
    install -Dm644 src-tauri/assets/notion-lite.desktop \
        "${pkgdir}/usr/share/applications/notion-lite.desktop"
    install -Dm644 LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 src-tauri/assets/icons/256x256.png \
        "${pkgdir}/usr/share/pixmaps/notion-lite.png"

    for size in 16 32 48 64 128 256 512; do
        install -Dm644 "src-tauri/assets/icons/${size}x${size}.png" \
            "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/notion-lite.png"
    done

    install -d "${pkgdir}/usr/lib/notion-lite"
    cp -a src-tauri/assets src-tauri/i18n "${pkgdir}/usr/lib/notion-lite/"
}
