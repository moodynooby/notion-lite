# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source and configuration files
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.desktop text eol=lf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.tar.* binary
*.deb binary
*.key binary
*.gpg binary
